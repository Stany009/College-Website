  "animations": {
    "logoStyles": {
      "pulse": {
        "name": "Pulse",
        "description": "Logo pulses in and out (default)",
        "cssClass": "anim-pulse"
      },
      "spin": {
        "name": "Spin",
        "description": "Logo rotates continuously",
        "cssClass": "anim-spin"
      },
      "bounce": {
        "name": "Bounce",
        "description": "Logo bounces up and down",
        "cssClass": "anim-bounce"
      },
      "shake": {
        "name": "Shake",
        "description": "Logo shakes side to side",
        "cssClass": "anim-shake"
      },
      "rubberBand": {
        "name": "Rubber Band",
        "description": "Logo stretches like rubber",
        "cssClass": "anim-rubber-band"
      },
      "jello": {
        "name": "Jello",
        "description": "Logo wobbles like jelly",
        "cssClass": "anim-jello"
      },
      "flip": {
        "name": "Flip",
        "description": "Logo flips horizontally",
        "cssClass": "anim-flip"
      },
      "none": {
        "name": "None",
        "description": "No animation",
        "cssClass": "anim-none"
      }
    },
    "barStyles": {
      "slide": {
        "name": "Slide",
        "description": "Bar slides across (default)",
        "cssClass": "bar-slide"
      },
      "fill": {
        "name": "Fill",
        "description": "Bar fills from left to right",
        "cssClass": "bar-fill"
      },
      "pulse": {
        "name": "Pulse",
        "description": "Bar pulses opacity",
        "cssClass": "bar-pulse"
      },
      "grow": {
        "name": "Grow",
        "description": "Bar grows from center",
        "cssClass": "bar-grow"
      },
      "none": {
        "name": "None",
        "description": "No animation",
        "cssClass": "bar-none"
      }
    },
    "presets": {
      "default": {
        "logoAnimation": "pulse",
        "barAnimation": "slide"
      },
      "energetic": {
        "logoAnimation": "bounce",
        "barAnimation": "fill"
      },
      "playful": {
        "logoAnimation": "rubberBand",
        "barAnimation": "pulse"
      },
      "minimal": {
        "logoAnimation": "none",
        "barAnimation": "fill"
      },
      "dramatic": {
        "logoAnimation": "flip",
        "barAnimation": "slide"
      }
    }
  },

  "accessibility": {
    "respectReducedMotion": true,
    "showLoaderText": true,
    "announceToScreenReader": true
  },

  "tips": {
    "howToAddNewPage": "1. Add a new entry to the 'pages' object with the page name as key",
    "howToChangeColors": "1. Update the 'colors' object for the specific page",
    "howToChangeIcon": "1. Update the 'icon' field with any emoji",
    "howToChangeText": "1. Update the 'text' field with the loading message",
    "howToChangeAnimation": "1. Modify the 'defaults.animation' object for timing changes",
    "howToChangeLogoAnimation": "1. Set 'logoAnimation' to: pulse, spin, bounce, shake, rubberBand, jello, flip, or none",
    "howToChangeBarAnimation": "1. Set 'barAnimation' to: slide, fill, pulse, grow, or none",
    "howToUsePreset": "1. Copy settings from 'animations.presets' to 'defaults.animation'",
    "availableLogoAnimations": "pulse, spin, bounce, shake, rubberBand, jello, flip, none",
    "availableBarAnimations": "slide, fill, pulse, grow, none"
  }
}
