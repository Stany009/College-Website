{
  "version": "1.0.0",
  "description": "Loading screen configuration for St. Andrew's College website",
  "documentation": "Edit this file to customize loading screen appearance without modifying CSS or JavaScript",
  
  "defaults": {
    "animation": {
      "showDelay": 100,
      "hideDelay": 300,
      "transitionDuration": 400,
      "maxLoadTime": 2000,
      "logoAnimation": "pulse",
      "barAnimation": "slide",
      "logoAnimationSpeed": 1.5,
      "barAnimationSpeed": 1.2
