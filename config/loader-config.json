    "colors": {
      "logoGradientStart": "#0B3D91",
      "logoGradientEnd": "#1a5bc4",
      "barGradientStart": "#0B3D91",
      "barGradientEnd": "#D4AF37",
      "textColor": "#64748B"
    },
    "dimensions": {
      "logoSize": 64,
      "barWidth": 120,
      "barHeight": 3
    }
  },

